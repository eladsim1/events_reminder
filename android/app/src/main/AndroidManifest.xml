<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- הרשאות עבור התראות מקומיות מתוזמנות -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- נדרשות לתזמון מדויק. שים לב: USE_EXACT_ALARM היא הרשאה מוגבלת
         ב-Google Play, המאושרת לאפליקציות שעון מעורר ויומן בלבד. להפצה
         בחנות ייתכן שיהיה צורך להסתמך על SCHEDULE_EXACT_ALARM בלבד. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- בלעדיה דיאלוג הפטור אינו נפתח והמשתמש מגיע לרשימה בהגדרות במקום.
         גם היא מוגבלת ב-Google Play – ראה BatteryExemption. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- נדרשת רק לכפתור "השתמש במיקום הנוכחי", ונשאלת בזמן הלחיצה. שימוש
         רגיל באפליקציה אינו נוגע במיקום. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- גיבוי מוצהר במפורש. מכשיר חדש או התקנה מחדש הם התרחיש היחיד
         שמאבד את כל הנתונים ולא רק תזכורת אחת, וללא הצהרה שום דבר לא כיוון
         את מה שנשמר ושום דבר לא אימת זאת. -->
    <application
        android:label="תזכורת אזכרות"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- singleTask ולא singleTop: הפלאגין בונה את כוונת ההפעלה מ-
             getLaunchIntentForPackage ואז מחליף לה את ה-action, כך שהיא כבר
             אינה תואמת לכוונת השורש של המשימה. עם singleTop, שמונע מופע נוסף
             רק כשהפעילות במקרה בראש הערימה, כל הקשה על התראה פתחה מופע נוסף.

             ואין כאן taskAffinity="" – התבנית של Flutter מוסיפה אותו, והוא
             לבדו מבטל את התיקון: כוונת ההפעלה נושאת FLAG_ACTIVITY_NEW_TASK,
             ואנדרואיד מאתר משימה קיימת לפי הזיקה. זיקה ריקה פירושה שאין למה
             להתאים, ולכן נפתחת משימה חדשה בכל פעם – singleTask או לא.

             המחיר: הזיקה חוזרת להיות שם החבילה, וזו ההגנה שהתבנית ויתרה
             עליה – אפליקציה זדונית שמצהירה על אותה זיקה יכולה להשתחל
             למשימה (StrandHogg). מול תקלה שקורית בפועל בכל הקשה, זו העדפה
             מודעת ולא פספוס. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- אזעקת הביקורת. אינה מציגה דבר – רושמת שהיא נורתה ומזמנת את
             עצמה מחדש, וכך חותמת שמתיישנת מסגירה שאנדרואיד מדכא אזעקות. -->
        <receiver android:exported="false"
            android:name=".CanaryReceiver">
            <!-- אתחול מוחק אזעקות. בלי זה הביקורת הייתה נשארת מחוקה עד
                 שהאפליקציה נפתחת, והחותמת הייתה מתיישנת בלי סיבה אמיתית. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- מקלטים עבור flutter_local_notifications: התראות מתוזמנות ואתחול לאחר הפעלה מחדש -->

        <!-- בלי המקלט הזה כפתורי ההתראה אינם עושים דבר: הפלאגין אינו מצהיר
             על מקלטים משלו, וה-PendingIntent של כל כפתור מכוון לרכיב שאינו
             קיים. הכפתור מוצג, הלחיצה נבלעת, ולא מגיעה שום קריאה ל-Dart. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"/>
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>

    <!-- נדרש ל-Flutter כדי לזהות אפליקציות לפתיחת קישורים/טקסט -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- נדרש מ-Android 11: בלי הצהרה על הסכמות, canLaunchUrl מחזיר false
             גם כשוויז או Google Maps מותקנים (package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- אותה מלכודת כמו geo: בלי ההצהרה canLaunchUrl מחזיר false על
             tel: גם כשיש אפליקציית חיוג, ושורת המשוב לא תיפתח. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
